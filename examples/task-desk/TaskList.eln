import type { Task } from "./types.js";

component TaskList(tasks: Task[], selectedId: string | null) {
  event selected(id: string)

  ui {
    if tasks.length === 0 {
      p "No tasks match this search and status."
    }
    ul .task-list {
      each task in tasks by task.id {
        li .task-row {
          button aria-current=(task.id === selectedId) `${task.id} · ${task.title}` => emit.selected(task.id)
          small `${task.status} · ${task.assignee || "Unassigned"} · ${task.priority} priority`
          if task.id === selectedId {
            strong "Selected"
          }
        }
      }
    }
  }
}
